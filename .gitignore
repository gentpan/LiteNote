# ============================================
# LiteNote .gitignore
# 忽略运行时数据、编译产物、用户上传、IDE 文件
# ============================================

# 运行时 SQLite 数据库(必须本地保留,绝不提交)
storage/database.sqlite
storage/database.sqlite-journal
storage/database.sqlite-shm
storage/database.sqlite-wal
storage/database.sqlite.installed

# 编译后的模板缓存(view 引擎产物,改源模板自动失效)
storage/cache/views/*.php

# 运行时日志
storage/logs/*.log
storage/logs/*.txt

# 用户上传文件(头像/附件,生产用)
public/assets/uploads/*
!public/assets/uploads/.gitkeep

# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp
*.orig
*~
.idea/workspace.xml

# 环境变量 / 凭据(永远不提交)
.env
.env.*
config.local.php
*.pem
*.key

# PHP 临时文件 / 缓存
*.php.bak
*.phps
.phpunit.result.cache
.phpunit.cache

# 部署 / 备份文件
*.tar.gz
*.zip
*.bak.*
deploy_*.log
litenote.bak.*

# 截图 / 临时
mavis-uploads/
*.png.tmp
avatar-*.png
nav-avatar-*.png

# PHP Composer(暂未用,留位)
vendor/
composer.lock

# 运行时缓存(RSS 抓取缓存 / 视图编译产物)
storage/cache/

# 文章正文 Markdown(运行时内容,随 DB 本地保留,不入库)
storage/posts/*.md

# Claude Code 本地配置 / 会话
.claude/
