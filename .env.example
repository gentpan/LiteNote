# LiteNote environment variables
# Copy this file to .env locally, then fill secrets there. .env is ignored by git.

# AI summary
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# X cards
# Optional. X_BEARER_TOKEN enables official API metrics/avatar/verified lookup.
X_BEARER_TOKEN=
# Fallback author profile for self-posted X cards when public endpoints omit profile data.
X_DEFAULT_NAME=
X_DEFAULT_HANDLE=
X_DEFAULT_AVATAR=
X_DEFAULT_VERIFIED=false

# Mail
MAIL_ENABLED=false
MAIL_DRIVER=sendflare
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=LiteNote
MAIL_NOTIFY_TO=
MAIL_POST_RECIPIENTS=

# SendFlare API
SENDFLARE_API_TOKEN=
SENDFLARE_ENDPOINT=https://api.sendflare.com/v1/send
COMMENT_NOTIFY_TO=

# Resend API
RESEND_API_KEY=

# Cloudflare Email Service REST API
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
