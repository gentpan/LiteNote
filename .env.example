# LiteNote environment variables
# Copy this file to .env locally, then fill secrets there. .env is ignored by git.

# App
APP_URL=http://127.0.0.1:5555
APP_DEBUG=false
# 32 字节以上随机字符串，用于邮件退订等 token 生成
APP_KEY=

# AI summary
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# X cards
# Optional. X_BEARER_TOKEN enables official API metrics/avatar/verified lookup.
X_BEARER_TOKEN=

# Optional. Meting.io token for admin music search/import.
METING_TOKEN=
METING_BASE_URL=https://api.meting.io
METING_QUALITY=exhigh

# NeteaseCloudMusicApi service for activity sync.
# Run with: npx NeteaseCloudMusicApi@latest
NETEASE_API_BASE_URL=http://127.0.0.1:3000
# Fallback author profile for self-posted X cards when public endpoints omit profile data.
X_DEFAULT_NAME=
X_DEFAULT_HANDLE=
X_DEFAULT_AVATAR=
X_DEFAULT_VERIFIED=false

# Mail
MAIL_ENABLED=false
MAIL_DRIVER=sendflare
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=LiteNote
MAIL_NOTIFY_TO=
MAIL_POST_RECIPIENTS=

# SendFlare API
SENDFLARE_API_TOKEN=
SENDFLARE_ENDPOINT=https://api.sendflare.com/v1/send
COMMENT_NOTIFY_TO=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Telegram talk publishing
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
