# LiteNote environment variables
# Copy this file to .env locally, then fill secrets there. .env is ignored by git.

# AI summary
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Umami analytics
UMAMI_ENABLED=false
UMAMI_BASE_URL=
UMAMI_WEBSITE_ID=
UMAMI_TOKEN=
UMAMI_API_KEY=
UMAMI_TIMEZONE=Asia/Shanghai
UMAMI_SCRIPT_URL=

# X cards
# Optional. X_BEARER_TOKEN enables official API metrics/avatar/verified lookup.
X_BEARER_TOKEN=
# Fallback author profile for self-posted X cards when public endpoints omit profile data.
X_DEFAULT_NAME=
X_DEFAULT_HANDLE=
X_DEFAULT_AVATAR=
X_DEFAULT_VERIFIED=false

# Mail / comments
SENDFLARE_API_TOKEN=
SENDFLARE_ENDPOINT=https://api.sendflare.com/v1/send
SENDFLARE_FROM=noreply@example.com
SENDFLARE_FROM_NAME=LiteNote
COMMENT_NOTIFY_TO=
